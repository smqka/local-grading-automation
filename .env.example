OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1

# Optional OpenAI-compatible gateway aliases.
# AI_KEY_TEST_API_KEY=your_gateway_key_here
# AI_KEY_TEST_BASE_URL=https://example.com/v1
# AI_KEY_TEST_MODEL=gpt-4.1

# Optional DeepSeek-compatible aliases.
# DEEPSEEK_API_KEY=your_deepseek_key_here
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_TEXT_MODEL=deepseek-chat
# DEEPSEEK_DRAFT_MODEL=deepseek-reasoner

PORT=5175

GRADING_API_HOST=127.0.0.1
GRADING_API_PORT=8765
GRADING_API_URL=http://127.0.0.1:8765
GRADING_API_TOKEN=
GRADING_MAX_IMAGE_BYTES=5242880
GRADING_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5175,http://127.0.0.1:5175
GRADING_PROXY_MAX_BODY_BYTES=25165824

# Optional: convert base64 images to public image URLs for gateways
# that accept image_url only when the URL is externally reachable.
# This uploads reference and cropped answer images to the selected third-party service.
# Leave empty unless you understand the privacy tradeoff.
# GRADING_IMAGE_URL_MODE=litterbox
# GRADING_IMAGE_URL_MODE=uguu
# GRADING_IMAGE_URL_MODE=imgbb
# IMGBB_API_KEY=your_imgbb_api_key_here
# IMGBB_EXPIRATION_SECONDS=600
# GRADING_IMAGE_UPLOAD_URL=https://your-own-upload-endpoint.example/upload
# GRADING_IMAGE_UPLOAD_FIELD=file
# GRADING_IMAGE_UPLOAD_RESPONSE_FORMAT=json
# GRADING_IMAGE_UPLOAD_RESPONSE_PATH=data.url
# GRADING_IMAGE_UPLOAD_EXTRA_FIELDS=reqtype=fileupload&time=1h
